# Copy this file to .env and fill in real values before running in production.

# Database Setup
DATABASE_URL=sqlite:///./jobshield.db

# MySQL Configuration for Node.js Express server
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=jobshield
DB_PORT=3306

# Admin auth
ADMIN_USERNAME=Menikaram
ADMIN_PASSWORD=menika123
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE_MINUTES=120

# File upload limits
MAX_UPLOAD_MB=8

# OCR
TESSERACT_CMD=tesseract

# Optional: web search / verification API key (if you plug in a real search API later)
SEARCH_API_KEY=
SEARCH_API_URL=

# CORS - frontend origin
FRONTEND_ORIGIN=http://localhost:5173
